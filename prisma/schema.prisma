generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  NEW
  WAITING_ON_QUOTE
  WAITING_ON_CUSTOMER
  SCHEDULED
  DONE
}

enum JobSource {
  PHONE
  WEBSITE
  TEXT
  REFERRAL
  REPEAT_CUSTOMER
  OTHER
}

model Job {
  id             String    @id @default(cuid())
  customerName   String
  company        String?
  phone          String?
  jobDescription String
  source         JobSource @default(OTHER)
  status         JobStatus @default(NEW)
  nextFollowUp   DateTime
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
