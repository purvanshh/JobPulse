generator client {
  provider      = "prisma-client-js"
  // native is local dev. The others are the Linux hosts used by Vercel,
  // Railway, and Render. Without them the deployed server cannot start Prisma.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  NEW
  WAITING_ON_QUOTE
  WAITING_ON_CUSTOMER
  SCHEDULED
  DONE
}

enum JobSource {
  PHONE
  WEBSITE
  TEXT
  REFERRAL
  REPEAT_CUSTOMER
  OTHER
}

enum ActivityType {
  CONTACTED
  NOTE
  STATUS_CHANGED
}

model Job {
  id             String     @id @default(cuid())
  customerName   String
  company        String?
  phone          String?
  jobDescription String
  source         JobSource  @default(OTHER)
  status         JobStatus  @default(NEW)
  nextFollowUp   DateTime
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  activities     Activity[]
}

model Activity {
  id        String       @id @default(cuid())
  jobId     String
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type      ActivityType
  note      String?
  createdAt DateTime     @default(now())
}
